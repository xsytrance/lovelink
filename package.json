{
  "name": "lovelink",
  "version": "1.0.0",
  "description": "LoveLink private live presence portal",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "check": "node --check server.js",
    "android:init": "node node_modules/@capacitor/cli/bin/capacitor add android",
    "android:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:open": "node node_modules/@capacitor/cli/bin/capacitor open android",
    "android:build": "cd android && ./gradlew assembleDebug",
    "android:build:win": "cd android && gradlew.bat assembleDebug",
    "cap": "node node_modules/@capacitor/cli/bin/capacitor"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.2",
    "@capacitor/cli": "^7.6.2",
    "@capacitor/core": "^7.6.2"
  }
}
